{
  "env": { "node": true, "es2022": true },
  "extends": ["eslint:recommended", "plugin:security/recommended-legacy"],
  "plugins": ["security"],
  "parserOptions": { "ecmaVersion": 2022 },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": "error",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "security/detect-object-injection": "off",
    "security/detect-non-literal-fs-filename": "off"
  },
  "ignorePatterns": ["node_modules/", "public/qrcode.min.js"],
  "overrides": [
    {
      "files": ["public/**/*.js"],
      "env": { "browser": true, "node": false, "es2022": true, "serviceworker": true },
      "rules": {
        "no-console": ["error", { "allow": ["error", "warn"] }],
        "security/detect-object-injection": "off",
        "security/detect-non-literal-fs-filename": "off",
        "security/detect-unsafe-regex": "off"
      }
    },
    {
      "files": ["public/app.js"],
      "globals": { "qrcode": "readonly" }
    },
    {
      "files": ["extension/**/*.js"],
      "env": { "browser": true, "webextensions": true, "node": false, "es2022": true },
      "rules": {
        "no-console": ["error", { "allow": ["error", "warn"] }],
        "security/detect-object-injection": "off",
        "security/detect-non-literal-fs-filename": "off",
        "security/detect-unsafe-regex": "off"
      }
    },
    {
      "files": ["extension/background.js"],
      "globals": { "importScripts": "readonly", "blinkGetSettings": "readonly", "blinkCreateLink": "readonly" }
    },
    {
      "files": ["extension/content.js"],
      "globals": { "blinkGetSettings": "readonly" }
    },
    {
      "files": ["extension/options.js"],
      "globals": { "blinkGetSettings": "readonly" }
    },
    {
      "files": ["extension/popup.js"],
      "globals": { "blinkEncryptSecret": "readonly", "blinkGeneratePassword": "readonly", "BLINK_API_BASE": "readonly" }
    },
    {
      "files": ["extension/crypto.js"],
      "globals": { "BLINK_API_BASE": "readonly", "BLINK_MAX_SECRET_BYTES": "readonly", "BLINK_DEFAULT_TTL_HOURS": "readonly" }
    }
  ]
}
