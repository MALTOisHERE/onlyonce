{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**/*.js",
			"**/*.json",
			"!**/node_modules",
			"!**/data",
			"!**/public/qrcode.min.js"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noConsole": "off",
				"noAssignInExpressions": "off",
				"noRedundantUseStrict": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useTemplate": "off"
			},
			"complexity": {
				"noForEach": "off"
			}
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	},
	"overrides": [
		{
			"includes": ["extension/config.js", "extension/crypto.js"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
