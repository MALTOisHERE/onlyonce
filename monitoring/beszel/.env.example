# Copy to .env in this same directory (never commit .env).

# How you'll reach the hub's dashboard. If you're putting nginx + TLS in
# front of it (recommended — see README.md), this should be that public
# URL, e.g. https://monitor.yourdomain.com. Left at the default, the hub
# is only reachable at http://localhost:8090 from inside this VPS.
BESZEL_APP_URL=http://localhost:8090

# Leave both blank until the hub is running and you've clicked "Add System"
# in its web UI — it generates these two values for you. See README.md.
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_KEY=
