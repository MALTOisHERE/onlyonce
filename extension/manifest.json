{
  "manifest_version": 3,
  "name": "Blink - Secure Secret Sharing",
  "short_name": "Blink",
  "version": "1.0.0",
  "description": "Create view-once, end-to-end encrypted secret links without leaving your browser.",
  "icons": {
    "16": "icons/icon-192.png",
    "32": "icons/icon-192.png",
    "48": "icons/icon-192.png",
    "128": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-192.png",
      "32": "icons/icon-192.png",
      "48": "icons/icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["contextMenus", "scripting", "activeTab", "notifications", "storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": ["https://blink.malto.icu/*"],
  "web_accessible_resources": [
    {
      "resources": ["icons/logo.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "blink-extension@malto.icu",
      "strict_min_version": "121.0"
    }
  }
}
